<Window x:Class="PitWatch.Gui.UpdateNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new" Height="480" Width="540"
        Icon="Assets/PitWatch.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BgDark}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="VersionHeader" Text="" FontSize="20" FontWeight="Bold"
                       FontFamily="Segoe UI" Foreground="{DynamicResource AccentGreen}"/>
            <TextBlock x:Name="CurrentVersionText" Text="" Foreground="{DynamicResource TextMuted}"
                       FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0"/>
            <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesText" Text="" TextWrapping="Wrap" FontFamily="Segoe UI"
                       FontSize="13" LineHeight="20"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Later" Style="{StaticResource GhostButton}" Padding="20,9" Margin="0,0,8,0" Click="Later_Click"/>
            <Button Content="Restart &amp; update" Style="{StaticResource PrimaryButton}" Padding="22,9" Click="UpdateNow_Click"/>
        </StackPanel>
    </Grid>
</Window>
