<Application x:Class="PitWatch.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Theme dictionaries (Dark/Light + Normal/Colorblind accents) are injected in
             App.xaml.cs OnStartup based on saved settings, before any window is created.
             Styles below use DynamicResource (not StaticResource) specifically because
             those theme dictionaries don't exist yet at the moment App.xaml itself first
             parses - DynamicResource defers the lookup until actually needed, StaticResource
             would fail immediately since App.xaml.cs hasn't run yet at that point. -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="BigStat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Application.Resources>
</Application>
