<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DEVELOPER TOOL - NOT SHIPPED.

    build-release.bat only publishes PitWatch.Gui, so this project never reaches users
    no matter what. That separation is deliberate: gating a dev panel behind a setting
    inside the main app would mean it's always present and one toggle away from being
    found. A separate exe that isn't packaged simply cannot appear.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>PitWatch.DevLauncher</AssemblyName>
    <RootNamespace>PitWatch.DevLauncher</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\PitWatch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PitWatch.Core\PitWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\PitWatch.ico" />
  </ItemGroup>

</Project>
