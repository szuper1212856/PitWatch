<Window x:Class="PitWatch.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PitWatch.Gui"
        Title="PitWatch Settings" Height="700" Width="880"
        Icon="Assets/PitWatch.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact header bar - deliberately different from the setup wizard's big
             centred logo and sidebar, so Settings reads as a utility screen rather than
             a repeat of onboarding. -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="VersionLabel" Text="" Margin="14,0,0,0" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="11"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16,12,16,0" Background="Transparent" BorderThickness="0">

            <TabItem Header="Engineer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Personality" Style="{StaticResource CardHeading}"/>
                                <TextBlock Text="Changes both the AI's answers and the scripted commentary." Style="{StaticResource CardHint}"/>
                                <RadioButton x:Name="PersonalityHelpful" Content="Helpful  -  banter, reactions, real personality" GroupName="Personality" Margin="0,4"/>
                                <RadioButton x:Name="PersonalityKind" Content="Kind  -  warm, encouraging, patient" GroupName="Personality" Margin="0,4"/>
                                <RadioButton x:Name="PersonalityMean" Content="Mean  -  blunt, sarcastic, holds nothing back" GroupName="Personality" Margin="0,4"/>
                                <RadioButton x:Name="PersonalityProfessional" Content="Professional  -  calm, precise, strictly business" GroupName="Personality" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="How much he talks" Style="{StaticResource CardHeading}"/>
                                <TextBlock Text="You can also type &quot;talk more&quot; or &quot;talk less&quot; mid-race." Style="{StaticResource CardHint}"/>
                                <RadioButton x:Name="ChattinessQuiet" Content="Quiet  -  only essential calls" GroupName="Chattiness" Margin="0,4"/>
                                <RadioButton x:Name="ChattinessNormal" Content="Normal  -  occasional banter" GroupName="Chattiness" Margin="0,4"/>
                                <RadioButton x:Name="ChattinessChatty" Content="Chatty  -  talks a lot more" GroupName="Chattiness" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="What he speaks up about" Style="{StaticResource CardHeading}"/>
                                <TextBlock Text="Damage, low fuel, race start and finish are always on." Style="{StaticResource CardHint}"/>
                                <CheckBox x:Name="AnnounceOvertakesCheck" Content="Overtakes and being overtaken" Margin="0,4"/>
                                <CheckBox x:Name="AnnounceLapAnalysisCheck" Content="Sector analysis after each lap" Margin="0,4"/>
                                <CheckBox x:Name="AnnounceProximityCheck" Content="Cars alongside" Margin="0,4"/>
                                <CheckBox x:Name="AnnounceTyreTempsCheck" Content="Tyre temperature warnings" Margin="0,4"/>
                                <CheckBox x:Name="AnnounceStintSummaryCheck" Content="Stint summary when you pit" Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Voice &amp; Keys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Gemini API key" Style="{StaticResource CardHeading}"/>
                                <TextBlock Style="{StaticResource CardHint}">
                                    <Run Text="Powers free-form questions and voice input."/>
                                    <LineBreak/>
                                    <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate">Get a free key</Hyperlink>
                                </TextBlock>
                                <local:ApiKeyBox x:Name="ApiKeyBox"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="TestGeminiButton" Content="Test key" Style="{StaticResource GhostButton}"
                                            Padding="14,7" Click="TestGemini_Click"/>
                                    <TextBlock x:Name="GeminiTestResult" VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="380"/>
                                </StackPanel>
                                <TextBlock Text="Model" Style="{StaticResource PanelLabel}" Margin="0,14,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ModelCombo" IsEditable="True" MinWidth="260"/>
                                    <Button x:Name="LoadModelsButton" Content="Load available" Style="{StaticResource GhostButton}"
                                            Padding="12,6" Margin="8,0,0,0" Click="LoadModels_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ModelStatusText" Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                           Text="Click Load available to fetch the models your key can use. Free-tier daily limits vary a lot per model - some newer ones allow only 20 requests a day, while lighter flash-lite models allow far more. Quotas and overload are both per-model, so switching is usually the fix for either."/>

                                <TextBlock Style="{StaticResource CardHint}" Margin="0,8,0,0"
                                           Text="The free tier has a per-minute and a per-day request cap. If you hit the daily one, questions and voice input stop working until it resets - PitWatch will tell you in the radio log when that happens. Everything else keeps working."/>
                                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentRed}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Voice" Style="{StaticResource CardHeading}"/>
                                <CheckBox x:Name="UseElevenLabsCheckBox" Content="Use ElevenLabs for a natural human voice"
                                          Margin="0,6,0,0" Checked="UseElevenLabsCheckBox_Changed" Unchecked="UseElevenLabsCheckBox_Changed"/>
                                <StackPanel x:Name="ElevenLabsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource CardHint}">
                                        <Hyperlink NavigateUri="https://elevenlabs.io/app/settings/api-keys" RequestNavigate="Hyperlink_RequestNavigate">Get an ElevenLabs key</Hyperlink>
                                        <Run Text=" - the free tier has a monthly character limit, and PitWatch falls back to the Windows voice when it runs out."/>
                                    </TextBlock>
                                    <local:ApiKeyBox x:Name="ElevenLabsKeyBox" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="TestElevenLabsButton" Content="Test key" Style="{StaticResource GhostButton}"
                                                Padding="14,7" Click="TestElevenLabs_Click"/>
                                        <TextBlock x:Name="ElevenLabsTestResult" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                    <TextBlock Text="Voice ID (optional)" Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI"/>
                                    <TextBox x:Name="ElevenLabsVoiceBox" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Text="Speech speed" Style="{StaticResource PanelLabel}" Margin="0,16,0,6"/>
                                <Slider x:Name="VoiceRateSlider" Minimum="-6" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left"/>
                                <TextBlock Text="Volume" Style="{StaticResource PanelLabel}" Margin="0,14,0,6"/>
                                <Slider x:Name="VoiceVolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="RadioBeepCheckBox" Content="Radio beep before each message" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Voice input" Style="{StaticResource CardHeading}"/>
                                <TextBlock Text="Hold a button, speak, release. Needs a Gemini key." Style="{StaticResource CardHint}"/>
                                <CheckBox x:Name="VoiceInputCheck" IsChecked="True" Content="Enable push-to-talk" Margin="0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BindButton" Content="Detect button" Style="{StaticResource GhostButton}" Padding="14,7" Click="BindButton_Click"/>
                                    <TextBlock x:Name="BindStatusText" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Callouts">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Custom callouts" Style="{StaticResource CardHeading}"/>
                            <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,0"
                                       Text="Write your own lines for each event. One per line - PitWatch picks a random one each time, so several lines keeps it varied. Leave blank to use the built-in lines."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="CalloutEventList" Grid.Column="0" SelectionChanged="CalloutEvent_Changed"/>
                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CalloutHintText" Grid.Row="0" Style="{StaticResource CardHint}" Text=""/>
                                <TextBox x:Name="CalloutTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" TextChanged="CalloutText_Changed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="CalloutStatusText" Margin="4,8,0,0" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" Text=""/>
                </Grid>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource CardHeading}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="DarkModeRadio" Content="Dark" GroupName="Theme" Margin="0,0,24,0"/>
                                    <RadioButton x:Name="LightModeRadio" Content="Light" GroupName="Theme"/>
                                </StackPanel>
                                <TextBlock Text="Accent colour" Style="{StaticResource PanelLabel}" Margin="0,20,0,10"/>
                                <ItemsControl x:Name="AccentSwatches">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <CheckBox x:Name="ColorblindCheckBox" Content="Colourblind-friendly colours (overrides accent)" Margin="0,14,0,0"/>
                                <TextBlock Text="Appearance changes apply after restarting PitWatch."
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Dashboard panels" Style="{StaticResource CardHeading}"/>
                                <CheckBox x:Name="ShowSpeedTraceCheck" Content="Speed trace graph" Margin="0,8,0,4"/>
                                <CheckBox x:Name="ShowPedalTraceCheck" Content="Throttle / brake / steering graph" Margin="0,4"/>
                                <CheckBox x:Name="ShowGForceCheck" Content="G-force meter" Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Track Map">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Car proximity &amp; track map" Style="{StaticResource CardHeading}"/>
                            <TextBlock Style="{StaticResource CardHint}"
                                       Text="Draws a live map with every car on it and warns about cars alongside. One click - PitWatch configures ACC for you. Restart ACC afterwards."/>
                            <Button x:Name="BroadcastingButton" Content="Turn on car proximity &amp; track map"
                                    Style="{StaticResource PrimaryButton}" Padding="16,10" HorizontalAlignment="Left"
                                    Click="BroadcastingButton_Click"/>
                            <TextBlock x:Name="BroadcastingStatusText" Text="" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Games">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Assetto Corsa Competizione" Style="{StaticResource CardHeading}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="Nothing to set up. ACC shares telemetry automatically - just launch it and PitWatch will connect."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="For the track map and car proximity warnings, use the one-click button on the Track Map tab."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Le Mans Ultimate" Style="{StaticResource CardHeading}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,10"
                                           Text="LMU doesn't share telemetry on its own. It needs a small community plugin - the same one Crew Chief and SimHub use, so you may already have it."/>

                                <TextBlock Text="STEP 1  -  GET THE PLUGIN" Style="{StaticResource PanelLabel}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0">
                                    <Hyperlink NavigateUri="https://github.com/TheIronWolfModding/rF2SharedMemoryMapPlugin/releases" RequestNavigate="Hyperlink_RequestNavigate">Download rFactor2SharedMemoryMapPlugin64.dll</Hyperlink>
                                    <LineBreak/>
                                    <Run Text="Put it in your LMU Plugins folder - the button below opens it for you."/>
                                </TextBlock>
                                <Button Content="Open LMU Plugins folder" Style="{StaticResource GhostButton}" Padding="14,8"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLmuFolder_Click"/>

                                <TextBlock Text="STEP 2  -  LAUNCH LMU ONCE" Style="{StaticResource PanelLabel}" Margin="0,16,0,0"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="Start Le Mans Ultimate, then close it. This makes it create the settings file that step 3 needs."/>

                                <TextBlock Text="STEP 3  -  ENABLE IT" Style="{StaticResource PanelLabel}" Margin="0,16,0,0"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="LMU has no plugin switch in its menus - it has to be enabled in a config file. PitWatch does that for you."/>
                                <Button x:Name="LmuEnableButton" Content="Enable LMU telemetry" Style="{StaticResource PrimaryButton}"
                                        Padding="16,10" HorizontalAlignment="Left" Margin="0,8,0,0" Click="LmuEnable_Click"/>
                                <TextBlock x:Name="LmuStatusText" Text="" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI"/>

                                <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,16,0,12"/>
                                <TextBlock Text="IF IT STILL DOESN'T CONNECT" Style="{StaticResource PanelLabel}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="LMU needs the Visual C++ 2013 runtime for this plugin to load. It's in the game's own Support\Runtimes folder, or from Microsoft. Also make sure LMU is running in Borderless or Windowed mode - the plugin doesn't work in exclusive Fullscreen."/>

                                <TextBlock Text="WHAT WORKS IN LMU" Style="{StaticResource PanelLabel}" Margin="0,16,0,0"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="Working: lap number, fuel, speed, gear, RPM, throttle, brake and steering. Not yet: race position, sector times, tyre and damage data - those live in a second data buffer PitWatch doesn't read yet. Track map and proximity warnings are ACC-only, as they use a broadcasting protocol LMU doesn't provide. ACC remains the more complete experience."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Developer mode" Style="{StaticResource CardHeading}"/>
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="Shows a diagnostics panel on the dashboard and enables the debug commands. Useful when something isn't working and you want to see why."/>
                                <CheckBox x:Name="DeveloperModeCheck" Content="Enable developer mode" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Diagnostics" Style="{StaticResource CardHeading}"/>
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="If something goes wrong, the log records what happened. Attaching it to a bug report makes it far easier to fix."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open log file" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0" Click="OpenLog_Click"/>
                                    <Button Content="Open data folder" Style="{StaticResource GhostButton}" Padding="14,8" Click="OpenDataFolder_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DataPathText" Text="" Margin="0,12,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource CardHeading}"/>
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="PitWatch is an independent community project. Not affiliated with Kunos Simulazioni, Studio 397, Google or ElevenLabs. Your API keys are encrypted and stored only on this PC."/>
                                <TextBlock x:Name="LimitationsText" Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="Tyre wear, flags, penalties and weather aren't available from the games' telemetry, so PitWatch can't report them."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource BgPanel}" Padding="20,12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="RestartHintText" Text="" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="330"/>
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="22,10" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SaveRestartButton" Content="Save &amp; restart" Style="{StaticResource GhostButton}"
                        Padding="22,10" Margin="0,0,8,0" Click="SaveRestart_Click"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="30,10" FontSize="14" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
