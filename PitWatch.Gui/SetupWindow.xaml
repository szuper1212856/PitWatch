<Window x:Class="PitWatch.Gui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PitWatch.Gui"
        Title="PitWatch Setup" Height="720" Width="900"
        Icon="Assets/PitWatch.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDark}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar nav: much harder to miss than a thin tab strip -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1B2230" Offset="0"/>
                    <GradientStop Color="#10141C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Image Source="Assets/Logo.png" Height="96" Margin="20,26,20,14"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle Height="2" Margin="24,0,24,20" RadiusX="1" RadiusY="1"
                               Fill="{DynamicResource AccentGreen}" Opacity="0.5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <RadioButton x:Name="NavAi" Content="AI &amp; Voice" GroupName="Nav" IsChecked="True"
                                 Style="{StaticResource NavItem}" Checked="Nav_Changed" Tag="0"/>
                    <RadioButton x:Name="NavPersonality" Content="Personality" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Changed" Tag="1"/>
                    <RadioButton x:Name="NavVoiceInput" Content="Voice Input" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Changed" Tag="2"/>
                    <RadioButton x:Name="NavTrackMap" Content="Track Map" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Changed" Tag="3"/>
                    <RadioButton x:Name="NavAlerts" Content="Alerts" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Changed" Tag="4"/>
                    <RadioButton x:Name="NavAppearance" Content="Appearance" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Changed" Tag="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,26,34,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="SectionTitle" Text="AI &amp; Voice" FontSize="26" FontWeight="Bold"
                       FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" x:Name="SectionSubtitle" Text="Optional - everything else works without these."
                       Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="12" Margin="0,38,0,0"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <Grid>
                    <!-- PAGE 0: AI & Voice -->
                    <StackPanel x:Name="PageAi">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="GEMINI API KEY" Style="{StaticResource PanelLabel}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" FontFamily="Segoe UI" FontSize="12">
                                    <Run Text="Unlocks asking questions in your own words. Leave blank to skip - fuel, tyres, damage, sector analysis and race commentary all work without it."/>
                                </TextBlock>
                                <TextBlock Margin="0,0,0,6">
                                    <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate">Get a free Gemini key</Hyperlink>
                                </TextBlock>
                                <local:ApiKeyBox x:Name="ApiKeyBox"/>
                                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentRed}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                                <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,24,0,20"/>

                                <TextBlock Text="VOICE" Style="{StaticResource PanelLabel}"/>
                                <CheckBox x:Name="UseElevenLabsCheckBox" Content="Use ElevenLabs for a natural human voice"
                                          Margin="0,10,0,0" Checked="UseElevenLabsCheckBox_Changed" Unchecked="UseElevenLabsCheckBox_Changed"/>
                                <StackPanel x:Name="ElevenLabsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,6">
                                        <Hyperlink NavigateUri="https://elevenlabs.io/app/settings/api-keys" RequestNavigate="Hyperlink_RequestNavigate">Get an ElevenLabs key</Hyperlink>
                                        <Run Text=" (free tier available). Without it, PitWatch uses the built-in Windows voice."/>
                                    </TextBlock>
                                    <local:ApiKeyBox x:Name="ElevenLabsKeyBox" Margin="0,0,0,8"/>
                                    <TextBlock Text="Voice ID (optional)" Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI"/>
                                    <TextBox x:Name="ElevenLabsVoiceBox" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Text="Speech speed" Style="{StaticResource PanelLabel}" Margin="0,20,0,6"/>
                                <Slider x:Name="VoiceRateSlider" Minimum="-6" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Width="280" HorizontalAlignment="Left"/>

                                <TextBlock Text="Volume" Style="{StaticResource PanelLabel}" Margin="0,16,0,6"/>
                                <Slider x:Name="VoiceVolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="280" HorizontalAlignment="Left"/>

                                <CheckBox x:Name="RadioBeepCheckBox" Content="Play radio beep before each message" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 1: Personality -->
                    <StackPanel x:Name="PagePersonality" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="ENGINEER PERSONALITY" Style="{StaticResource PanelLabel}"/>
                                <TextBlock Text="Changes both the AI's answers and the scripted race commentary."
                                           Foreground="{DynamicResource TextMuted}" FontSize="12" FontFamily="Segoe UI" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <RadioButton x:Name="PersonalityHelpful" Content="Helpful  -  banter, reactions, real personality" GroupName="Personality" Margin="0,5"/>
                                <RadioButton x:Name="PersonalityKind" Content="Kind  -  warm, encouraging, patient" GroupName="Personality" Margin="0,5"/>
                                <RadioButton x:Name="PersonalityMean" Content="Mean  -  blunt, sarcastic, holds nothing back" GroupName="Personality" Margin="0,5"/>
                                <RadioButton x:Name="PersonalityProfessional" Content="Professional  -  calm, precise, strictly business" GroupName="Personality" Margin="0,5"/>

                                <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,24,0,20"/>

                                <TextBlock Text="HOW MUCH HE TALKS" Style="{StaticResource PanelLabel}"/>
                                <RadioButton x:Name="ChattinessQuiet" Content="Quiet  -  only essential calls" GroupName="Chattiness" Margin="0,10,0,5"/>
                                <RadioButton x:Name="ChattinessNormal" Content="Normal  -  occasional banter between calls" GroupName="Chattiness" Margin="0,5"/>
                                <RadioButton x:Name="ChattinessChatty" Content="Chatty  -  talks a lot more often" GroupName="Chattiness" Margin="0,5"/>
                                <TextBlock Text='You can also type "talk more" or "talk less" anytime while racing.'
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 2: Track Map -->
                    <StackPanel x:Name="PageTrackMap" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="CAR PROXIMITY &amp; TRACK MAP" Style="{StaticResource PanelLabel}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,14"
                                           Text="Draws a live track map with every car on it, and warns you about cars alongside. One click - PitWatch sets up ACC's side for you."/>
                                <Button x:Name="BroadcastingButton" Content="Turn on car proximity &amp; track map"
                                        Style="{StaticResource PrimaryButton}" Padding="16,10" HorizontalAlignment="Left"
                                        Click="BroadcastingButton_Click"/>
                                <TextBlock x:Name="BroadcastingStatusText" Text="" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Text="Restart ACC afterwards so it picks up the change."
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 3: Appearance -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="THEME" Style="{StaticResource PanelLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="DarkModeRadio" Content="Dark" GroupName="Theme" Margin="0,0,24,0"/>
                                    <RadioButton x:Name="LightModeRadio" Content="Light" GroupName="Theme"/>
                                </StackPanel>

                                <TextBlock Text="ACCENT COLOR" Style="{StaticResource PanelLabel}" Margin="0,24,0,10"/>
                                <ItemsControl x:Name="AccentSwatches">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <CheckBox x:Name="ColorblindCheckBox" Content="Colorblind-friendly colors (overrides accent choice)" Margin="0,20,0,0"/>

                                <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,24,0,20"/>

                                <TextBlock Text="DASHBOARD PANELS" Style="{StaticResource PanelLabel}"/>
                                <CheckBox x:Name="ShowSpeedTraceCheck" Content="Speed trace graph" Margin="0,10,0,5"/>
                                <CheckBox x:Name="ShowPedalTraceCheck" Content="Throttle / brake / steering graph" Margin="0,5"/>
                                <CheckBox x:Name="ShowGForceCheck" Content="G-force meter" Margin="0,5"/>

                                <TextBlock Text="Appearance changes apply after restarting PitWatch."
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 4: Alerts -->
                    <StackPanel x:Name="PageAlerts" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="WHAT HE SPEAKS UP ABOUT" Style="{StaticResource PanelLabel}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,12"
                                           Text="Safety-critical calls (damage, low fuel, race start and finish) are always on."/>
                                <CheckBox x:Name="AnnounceOvertakesCheck" Content="Overtakes and being overtaken" Margin="0,5"/>
                                <CheckBox x:Name="AnnounceLapAnalysisCheck" Content="Sector analysis after each lap" Margin="0,5"/>
                                <CheckBox x:Name="AnnounceProximityCheck" Content="Cars alongside (needs track map turned on)" Margin="0,5"/>
                                <CheckBox x:Name="AnnounceTyreTempsCheck" Content="Tyre temperature warnings" Margin="0,5"/>
                                <CheckBox x:Name="AnnounceStintSummaryCheck" Content="Stint summary after each pit stop" Margin="0,5"/>

                                <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,20,0,16"/>
                                <TextBlock Text="CUSTOM CALLOUTS" Style="{StaticResource PanelLabel}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12" FontFamily="Segoe UI" Margin="0,4,0,10"
                                           Text="Your engineer has built-in lines for every event. You can write your own instead - pick an event and type one line per variation, and PitWatch picks a random one each time."/>
                                <Grid Height="240">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="CalloutEventList" Grid.Column="0" SelectionChanged="CalloutEvent_Changed"/>
                                    <Grid Grid.Column="1" Margin="12,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="CalloutHintText" Grid.Row="0" Text=""
                                                   Foreground="{DynamicResource TextMuted}" FontSize="11"
                                                   FontFamily="Segoe UI" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBox x:Name="CalloutTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" TextChanged="CalloutText_Changed"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="CalloutStatusText" Text="" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PAGE 5: Voice Input -->
                    <StackPanel x:Name="PageVoiceInput" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="PUSH-TO-TALK" Style="{StaticResource PanelLabel}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12" FontFamily="Segoe UI" Margin="0,4,0,12"
                                           Text="Hold a button on your wheel and speak. PitWatch records while it's held and transcribes what you said. Needs a Gemini API key - transcription runs through it."/>
                                <CheckBox x:Name="VoiceInputEnabledCheck" IsChecked="True" Content="Enable push-to-talk voice input" Margin="0,0,0,14"/>

                                <TextBlock Text="BOUND BUTTON" Style="{StaticResource PanelLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="BindButton" Content="Bind a wheel button" Style="{StaticResource PrimaryButton}"
                                            Padding="16,10" Click="BindButton_Click"/>
                                    <TextBlock x:Name="BindingText" Text="Nothing bound" VerticalAlignment="Center" Margin="14,0,0,0" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Text="Click the button above, then press and hold any button on your wheel."
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" FontFamily="Segoe UI" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Rectangle Height="1" Fill="{DynamicResource ControlBg}" Margin="0,16,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="Back" Style="{StaticResource GhostButton}"
                            Padding="20,11" Visibility="Collapsed" Click="BackButton_Click"/>
                    <TextBlock x:Name="StepCounterText" Grid.Column="1" Text="" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="12"/>
                    <Button x:Name="ContinueButton" Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}"
                            Padding="30,11" FontSize="14" Click="ContinueButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
