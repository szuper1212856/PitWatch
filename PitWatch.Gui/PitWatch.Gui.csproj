<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>PitWatch.Gui</AssemblyName>
    <RootNamespace>PitWatch.Gui</RootNamespace>
    <!-- Velopack runs the app with special arguments during install/update, so it needs a
         real Main() it can hook before WPF spins up. That means opting out of the
         auto-generated entry point and pointing at our own. -->
    <StartupObject>PitWatch.Gui.App</StartupObject>
    <Version>1.0.1</Version>
    <!-- Icon shown on the .exe, taskbar, and window title bar. -->
    <ApplicationIcon>Assets\PitWatch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PitWatch.Core\PitWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required alongside StartupObject: without this the WPF SDK still generates its own
         Main and the build fails with duplicate entry points. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\PitWatch.ico" />
  </ItemGroup>

</Project>
