<Window x:Class="PitWatch.Gui.TrackMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PitWatch - Track Map" Height="620" Width="620"
        Background="{DynamicResource BgDark}"
        Icon="Assets/PitWatch.ico"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource Panel}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TRACK MAP" Style="{StaticResource PanelLabel}"/>
                <CheckBox Grid.Column="1" x:Name="AlwaysOnTopCheck" Content="Always on top"
                          Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" FontSize="11"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Canvas x:Name="PopoutMapCanvas" Background="#0E1219"/>
                <TextBlock x:Name="PopoutStatusText" Text="" Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="12" FontSize="13"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                <TextBlock Text="You" Margin="6,0,16,0" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentPurple}" VerticalAlignment="Center"/>
                <TextBlock Text="Other cars" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
